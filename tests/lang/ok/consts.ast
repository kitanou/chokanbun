(module
  (const 「引五」 有符六四 (負 (int 5)))
  (const 「下限」 有符六四 (減 (int 0) (int 147244780800)))
  (const 「和」 有符六四 (加 (int 1) (乘 (int 2) (int 3))))
  (const 「比」 真偽 (小於 「引五」 (int 0)))
  (const 「底」 無符六四 (int 18446743926464770816))
  (const 「実値」 真偽 真)
  (const 「針値」 指標〈無符八〉 空)
  (fn 「試算」 (params) (ret 有符六四)
    (let 「反」 有符六四 (負 (int 7)))
    (let 「合」 有符六四 (加 「和」 「引五」))
    (return (加 (加 「合」 「反」) 「下限」))
  )
  (fn 「試底」 (params) (ret 無符六四)
    (return 「底」)
  )
  (fn 「試真」 (params) (ret 真偽)
    (return (且 「実値」 「比」))
  )
  (fn 「試針」 (params) (ret 指標〈無符八〉)
    (return 「針値」)
  )
)
