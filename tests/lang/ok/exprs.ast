(module
  (struct 「對」 (「左」 無符六四) (「右」 無符六四))
  (fn 「雙」 (params (「值」 無符六四)) (ret 無符六四)
    (return (加 「值」 「值」))
  )
  (fn 「式」 (params (「甲」 無符六四) (「乙」 無符六四)) (ret 無符六四)
    (let 「演算」 無符六四 (減 (加 「甲」 「乙」) (餘 (除 (乘 「甲」 「乙」) 「乙」) 「甲」)))
    (let 「移」 無符六四 (右移 (左移 「甲」 (int 2)) (int 1)))
    (let 「論」 真偽 (或 (且 (小於 「甲」 「乙」) (小等 「乙」 「甲」)) (且 (大於 「甲」 「乙」) (大等 「甲」 「乙」))))
    (let 「等」 真偽 (或 (等於 「甲」 「乙」) (不等 「甲」 「乙」)))
    (let 「位」 無符六四 (位或 (位與 「甲」 「乙」) (位異 「甲」 「乙」)))
    (let 「單」 有符六四 (負 (int 7)))
    (let 「非」 真偽 (非 「論」))
    (let 「位非」 無符六四 (位非 「甲」))
    (let 「呼」 無符六四 (呼 「雙」 「甲」))
    (let 「字」 無符六四 (長度 (str 『世界安寧』)))
    (let 「文」 指標〈無符八〉 (取址 (str 『世界安寧』)))
    (let 「空針」 指標〈無符八〉 空)
    (let 「值」 無符八 (轉 無符八 「甲」))
    (let 「十六」 無符六四 (int 255))
    (let 「大十六」 無符六四 (int 8000))
    (let 「最大」 無符六四 (int 18446744073709551615))
    (return 「演算」)
  )
  (fn 「記憶」 (params (「對」 指標〈無符六四〉)) (ret 無符六四)
    (let 「物」 對 (轉 對 (int 0)))
    (unsafe
      (let 「讀」 無符六四 (讀揮發 無符六四 「對」))
      (expr (寫揮發 無符六四 「對」 (加 「讀」 (int 1))))
      (expr (障壁 シーケンス))
      (let 「元」 無符六四 (項 「對」 (int 0)))
      (let 「針」 指標〈無符八〉 (轉 指標〈無符八〉 「讀」))
      (let 「取」 無符八 (取值 「針」))
    )
    (return (int 0))
  )
  (fn 「欄項」 (params) (ret 無符六四)
    (let 「物」 對 (轉 對 (int 0)))
    (let 「左值」 無符六四 (欄 「物」 「左」))
    (set (欄 「物」 「右」) (加 「左值」 (int 1)))
    (let 「列」 列陣〈無符八,4〉 (轉 列陣〈無符八,4〉 (int 0)))
    (let 「第二」 無符八 (項 「列」 (int 2)))
    (set (項 「列」 (int 1)) (int 7))
    (let 「針」 指標〈對〉 (取址 「物」))
    (return 「左值」)
