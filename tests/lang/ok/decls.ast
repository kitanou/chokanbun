(module
  (alias 「字」 無符八)
  (alias 「針」 指標〈無符八〉)
  (alias 「頁」 列陣〈無符八,16〉)
  (struct 「點」 (「橫」 有符三二) (「縱」 有符三二))
  (struct 「寬」 (「甲」 無符十六) (「乙」 有符八) (「丙」 有符十六) (「丁」 有符六四))
  (struct 「帳」 (「識」 無符六四) (「名」 針) (「點」 點))
  (const 「頁幅」 無符六四 (int 4096))
  (const 「負值」 有符六四 (負 (int 5)))
  (const 「真値」 真偽 真)
  (const 「無針」 指標〈無符八〉 空)
  (extern 「核外字元」 (params (「字」 無符八)) (ret 無) (symbol "uart_putc"))
  (extern 「核外輸出」 (params (「址」 指標〈無符八〉) (「長」 無符六四)) (ret 無))
  (fn 「空術」 (params) (ret 無)
  )
  (fn 「加算」 (params (「甲」 無符六四) (「乙」 無符六四)) (ret 無符六四)
    (return (加 「甲」 「乙」))
  )
  (fn 「公術」 (params) (ret 無) public
  )
  (fn 「記號術」 (params) (ret 無) public (symbol "exported_sym")
  )
  (fn 「起動術」 (params) (ret 無) public (section ".text.boot")
  )
  (fn 「停止」 (params) (ret 無) noreturn
    (while 真
    )
  )
)
