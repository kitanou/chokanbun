(module
  (fn 「優先」 (params (「甲」 無符六四) (「乙」 無符六四) (「丙」 無符六四)) (ret 無)
    (let 「一」 無符六四 (加 「甲」 (乘 「乙」 「丙」)))
    (let 「二」 無符六四 (減 (減 「甲」 「乙」) 「丙」))
    (let 「三」 無符六四 (加 (乘 「甲」 「乙」) 「丙」))
    (let 「四」 無符六四 (左移 「甲」 (加 「乙」 「丙」)))
    (let 「五」 真偽 (或 (且 (小於 「甲」 「乙」) (小於 「乙」 「丙」)) (等於 「甲」 「丙」)))
    (let 「六」 無符六四 (位或 「甲」 (位異 「乙」 (位與 「丙」 「甲」))))
    (let 「七」 有符六四 (加 (負 (int 7)) (int 1)))
    (let 「八」 真偽 (且 (非 真) 偽))
    (let 「九」 無符六四 (加 (位非 「甲」) 「乙」))
    (let 「十」 無符六四 (乘 (加 「甲」 「乙」) 「丙」))
    (let 「十一」 真偽 (等於 (加 「甲」 「乙」) (加 「丙」 「甲」)))
  )
)
