(module
  (extern 「核外輸出」 (params (「址」 指標〈無符八〉) (「長」 無符六四)) (ret 無))
  (extern 「核外字元」 (params (「字」 無符八)) (ret 無))
  (fn 「異常處理」 (params (「異常値」 無符六四) (「復歸址」 無符六四)) (ret 無符六四) public (symbol "exception_dispatch")
    (do 「核外輸出」 (取址 (str 『異常捕獲 ESR=』)) (長度 (str 『異常捕獲 ESR=』)))
    (do 「核外十六」 「異常値」)
    (return (加 「復歸址」 (int 4)))
  )
  (fn 「核外十六」 (params (「値」 無符六四)) (ret 無)
    (do 「核外字元」 (int 48))
    (do 「核外字元」 (int 120))
    (let 「回」 無符六四 (int 0))
    (while (小於 「回」 (int 16))
      (let 「段」 無符六四 (減 (int 15) 「回」))
      (let 「半」 無符六四 (位與 (右移 「値」 (乘 「段」 (int 4))) (int 15)))
      (if (小於 「半」 (int 10))
        (then
          (do 「核外字元」 (轉 無符八 (加 「半」 (int 48))))
        )
        (else
          (do 「核外字元」 (轉 無符八 (加 「半」 (int 87))))
        )
      )
      (set 「回」 (加 「回」 (int 1)))
    )
    (do 「核外字元」 (int 10))
  )
)
